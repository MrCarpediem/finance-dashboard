# ── Shared Secrets (used by docker-compose env substitution) ──
JWT_SECRET=financepro_super_secret_jwt_key_change_in_production_min50chars
JWT_REFRESH_SECRET=financepro_refresh_secret_change_in_production_min50

# ── PostgreSQL ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# ── Auth Service (services/auth-service/.env) ──
# PORT=4001
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/auth_db
# JWT_SECRET=<same as above>
# JWT_EXPIRES_IN=15m
# BCRYPT_ROUNDS=12

# ── Finance Service (services/finance-service/.env) ──
# PORT=4002
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/finance_db
# JWT_SECRET=<same as above>

# ── Analytics Service (services/analytics-service/.env) ──
# PORT=4003
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/finance_db
# JWT_SECRET=<same as above>

# ── API Gateway (services/api-gateway/.env) ──
# PORT=3001
# JWT_SECRET=<same as above>
# AUTH_SERVICE_URL=http://auth-service:4001
# FINANCE_SERVICE_URL=http://finance-service:4002
# ANALYTICS_SERVICE_URL=http://analytics-service:4003

# ── Frontend (client) ──
# VITE_API_URL=http://localhost:3001/api  (for local dev)
